---
import EmailLink from '../EmailLink.astro';
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <dl class="grid gap-6 lg:grid-cols-3">
      <!-- Address -->
      <div class="bg-primary-500/10 dark:bg-primary-400/10 rounded-3xl px-6 py-8">
        <dt class="sr-only">Location</dt>
        <dd class="flex h-full flex-col justify-between gap-12">
          <svg
            class="text-primary-600 dark:text-primary-400 h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 23.7279L5.63604 17.364C2.12132 13.8492 2.12132 8.15076 5.63604 4.63604C9.15076 1.12132 14.8492 1.12132 18.364 4.63604C21.8787 8.15076 21.8787 13.8492 18.364 17.364L12 23.7279ZM16.9497 15.9497C19.6834 13.2161 19.6834 8.78392 16.9497 6.05025C14.2161 3.31658 9.78392 3.31658 7.05025 6.05025C4.31658 8.78392 4.31658 13.2161 7.05025 15.9497L12 20.8995L16.9497 15.9497ZM12 13C10.8954 13 10 12.1046 10 11C10 9.89543 10.8954 9 12 9C13.1046 9 14 9.89543 14 11C14 12.1046 13.1046 13 12 13Z"
            ></path>
          </svg>
          <div class="text-base font-medium">
            <p>Albons, Alt Empordà</p>
            <p>Girona, Catalonia</p>
          </div>
        </dd>
      </div>

      <!-- LinkedIn -->
      <div class="bg-primary-500/10 dark:bg-primary-400/10 rounded-3xl px-6 py-8">
        <dt class="sr-only">LinkedIn</dt>
        <dd class="flex h-full flex-col justify-between gap-12">
          <svg
            class="text-primary-600 dark:text-primary-400 h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M6.94 5a2 2 0 1 1-4-.002 2 2 0 0 1 4 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91l.04-1.68z"/>
          </svg>
          <p class="text-base font-medium">
            <a
              href="https://www.linkedin.com/in/arielconde/"
              target="_blank"
              rel="noopener"
              class="hover:underline"
            >
              linkedin.com/in/arielconde
            </a>
          </p>
        </dd>
      </div>

      <!-- Email -->
      <div class="bg-primary-500/10 dark:bg-primary-400/10 rounded-3xl px-6 py-8">
        <dt class="sr-only">Email</dt>
        <dd class="flex h-full flex-col justify-between gap-12">
          <svg
            class="text-primary-600 dark:text-primary-400 h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M3 3H21C21.5523 3 22 3.44772 22 4V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3ZM20 7.23792L12.0718 14.338L4 7.21594V19H20V7.23792ZM4.51146 5L12.0619 11.662L19.5078 5H4.51146Z"></path>
          </svg>
          <p class="text-base font-medium">
            <EmailLink email="hola@arielcnd.com" class="hover:underline" />
          </p>
        </dd>
      </div>
    </dl>
  </div>
</section>
