---
interface Props {
  email: string;
  class?: string;
}

const { email, class: className } = Astro.props;

// Convertir correu a base64 per al href
const encoded = Buffer.from(email).toString('base64');

// Convertir correu a HTML entities per al text visible
const emailEntities = Array.from(email)
  .map(c => `&#${c.charCodeAt(0)};`)
  .join('');
---

<a href="#" class={`email-link ${className || ''}`} data-email={encoded}>
  <span set:html={emailEntities}></span>
</a>

<script>
  document.querySelectorAll('.email-link').forEach(link => {
    const encoded = link.getAttribute('data-email');
    if (encoded) {
      try {
        const email = atob(encoded);
        link.href = `mailto:${email}`;
      } catch {
        // fallback
      }
    }
  });
</script>
