---
interface Props {
  label: string;
  value: string;
  icon?: string;
}

const { label, value, icon } = Astro.props;
---

<div class="bg-slate-800/50 border border-slate-700 rounded-2xl p-6 sm:p-8 hover:border-blue-500/50 transition-colors duration-300">
  {icon && (
    <div class="text-3xl mb-3 opacity-80">{icon}</div>
  )}
  <div class="text-slate-400 text-sm font-medium uppercase tracking-wide mb-1">
    {label}
  </div>
  <div class="text-3xl sm:text-4xl font-bold text-white">
    {value}
  </div>
</div>
