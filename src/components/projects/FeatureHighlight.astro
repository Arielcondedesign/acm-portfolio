---
interface Props {
  title: string;
  description: string;
  icon?: string;
}

const { title, description, icon } = Astro.props;
---

<div class="bg-slate-800/30 border border-slate-700 rounded-2xl p-6 sm:p-8 hover:border-blue-500/50 hover:bg-slate-800/50 transition-all duration-300">
  {icon && (
    <div class="text-3xl sm:text-4xl mb-4">{icon}</div>
  )}
  <h3 class="text-lg sm:text-xl font-bold text-white mb-2">
    {title}
  </h3>
  <p class="text-slate-400 text-sm leading-relaxed">
    {description}
  </p>
</div>
