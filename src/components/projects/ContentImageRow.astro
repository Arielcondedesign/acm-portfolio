---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  content: string;
  image: string;
  imageAlt: string;
  imagePosition: 'left' | 'right';
  imageCaption?: string;
}

const { title, content, image, imageAlt, imagePosition, imageCaption } = Astro.props;
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center py-12">
  <!-- Imagen -->
  <figure class={imagePosition === 'right' ? 'lg:order-2' : ''}>
    <Image
      src={image}
      alt={imageAlt}
      width={500}
      height={400}
      class="w-full h-auto rounded-2xl shadow-xl"
    />
    {imageCaption && (
      <figcaption class="text-center text-slate-400 text-sm mt-3">
        {imageCaption}
      </figcaption>
    )}
  </figure>

  <!-- Contenido -->
  <div class={imagePosition === 'right' ? '' : 'lg:order-2'}>
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
      {title}
    </h2>
    <div class="prose prose-invert max-w-none">
      <p class="text-slate-300 text-base leading-relaxed whitespace-pre-wrap">
        {content}
      </p>
    </div>
  </div>
</div>
