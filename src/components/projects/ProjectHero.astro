---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
}

const { title, description, image, tags } = Astro.props;
---

<div class="relative h-96 sm:h-[500px] lg:h-[600px] overflow-hidden rounded-3xl bg-slate-700 mb-12">
  <!-- Imagen de fondo -->
  <Image
    src={image}
    alt={title}
    width={1440}
    height={600}
    class="w-full h-full object-cover"
    loading="eager"
  />

  <!-- Gradient overlay oscuro -->
  <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent"></div>

  <!-- Contenido en overlay -->
  <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-8 lg:p-12">
    <div class="max-w-3xl">
      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span class="inline-flex items-center px-3 py-1 text-xs font-semibold text-blue-300 bg-blue-900/40 rounded-full border border-blue-500/30 backdrop-blur-sm">
            {tag}
          </span>
        ))}
      </div>

      <!-- Título -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-3 leading-tight">
        {title}
      </h1>

      <!-- Descripción -->
      <p class="text-base sm:text-lg text-slate-200 max-w-2xl line-clamp-2 sm:line-clamp-none">
        {description}
      </p>
    </div>
  </div>
</div>
