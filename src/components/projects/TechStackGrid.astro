---
interface Tool {
  name: string;
  category?: string;
}

interface Props {
  tools: Tool[];
}

const { tools } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 py-12">
  {tools.map((tool) => (
    <div class="bg-slate-800/30 border border-slate-700 rounded-2xl p-4 text-center hover:border-blue-500/50 transition-colors duration-300">
      <div class="font-semibold text-white text-sm sm:text-base mb-1">
        {tool.name}
      </div>
      {tool.category && (
        <div class="text-slate-400 text-xs uppercase tracking-wide">
          {tool.category}
        </div>
      )}
    </div>
  ))}
</div>
