---
const values = [
  [
    {
      ref: '01',
      name: 'How I work',
      description:
        "End-to-end and lean. I like to validate ideas through small experiments rather than big upfront bets, and I'm happiest involved in the whole process — research, architecture, UI and prototyping — not just one slice of it.",
    },
    {
      ref: '02',
      name: 'Accessibility & sustainability built in',
      description:
        "I design with accessibility (WCAG AA) and low-carbon principles from the start, not as a final checklist. I'm not afraid to question a brief when a feature adds complexity without adding real value.",
    },
  ],
  [
    {
      ref: '03',
      name: "What I'm looking for",
      description:
        "A product designer role at a consumer company whose mission I can believe in — climate, wellbeing, sustainable commerce or travel with purpose. Based in Catalonia, open to remote and hybrid roles across Europe.",
    },
    {
      ref: '04',
      name: 'Outside work',
      description:
        'Analog photography, gardening, cooperative living, and a slow, low-carbon internet.',
    },
  ],
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-8 lg:gap-12">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">More about me</h2>
      <div class="grid gap-8 lg:grid-cols-2">
        {
          values.map((column, index) => (
            <div class:list={['space-y-8', index === 1 && 'lg:mt-16']}>
              {column.map((value) => (
                <div class="bg-primary-500/10 dark:bg-primary-400/10 flex flex-col gap-12 rounded-3xl px-6 py-8">
                  <p class="text-sm">{value.ref}</p>
                  <div class="flex flex-col gap-4">
                    <h3 class="text-xl font-medium">{value.name}</h3>
                    <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
                      {value.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
