---
const stats = [
  { name: 'Years of experience', value: '15' },
  { name: 'Digital projects', value: '20+' },
  { name: 'Accessibility standard', value: 'WCAG AA' },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <figure class="mx-auto">
        <img
          class="h-auto w-full max-w-xl rounded-3xl"
          width="576"
          height="864"
          src="/assets/ArielConde-Product-Designer.webp"
          alt="Ariel Conde, product designer based in Catalonia"
        />
        <figcaption class="text-right text-sm text-primary-950/40 dark:text-primary-200/40 mt-2">
          © June 2021 Elisabet Encina
        </figcaption>
      </figure>
      <div class="flex flex-col gap-10">
        <div class="space-y-8 sm:space-y-12">
          <div class="space-y-6">
            <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">How I got here</h2>
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              I started in Barcelona advertising agencies (Contrapunto BBDO, El Guateque), doing graphic design and art direction for brands like Danone, Škoda and Gas Natural. I studied photography, moved into editorial and web design, and eventually into UX/UI through a Master's at KSchool. The thread connecting all of it is the same: I've always been obsessed with how visual and digital decisions change what people do.
            </p>
            <h2 class="text-3xl font-medium tracking-tight sm:text-4xl pt-4">What I do now</h2>
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              I design consumer-facing digital products with a focus on sustainability and meaningful use. I've worked on fashion e-commerce, sport and community platforms, IoT applications and luxury retail. I run a small studio, <a href="https://regeneralia.cat" target="_blank" rel="noopener" class="underline hover:no-underline">Regeneralia</a>, where I help purpose-driven brands improve the performance, accessibility and environmental footprint of their digital products.
            </p>
          </div>
        </div>

        <dl class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {
            stats.map((stat) => (
              <div class="border-primary-900/10 dark:border-primary-300/10 rounded-3xl border p-6">
                <dt class="text-sm text-primary-950/60 dark:text-primary-200/60">{stat.name}</dt>
                <dd class="text-2xl font-medium tracking-tight mt-1">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
