---
interface Props {
  label: string;
  value: string;
  icon?: string;
}

const { label, value, icon } = Astro.props;
---

<div class="bg-primary-500/10 dark:bg-primary-400/10 border border-primary-950/20 dark:border-primary-200/20 rounded-2xl p-6 sm:p-8 hover:border-primary-950/40 dark:hover:border-primary-200/40 transition-colors duration-300">
  {icon && (
    <div class="text-3xl mb-3 opacity-80">{icon}</div>
  )}
  <div class="text-primary-950/50 dark:text-primary-200/50 text-sm font-medium uppercase tracking-wide mb-1">
    {label}
  </div>
  <div class="text-3xl sm:text-4xl font-bold">
    {value}
  </div>
</div>
