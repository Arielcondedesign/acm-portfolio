---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const cases = await getCollection('portfolio');
const sorted = cases
  .filter((c) => c.data.published !== false)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout
  title="Portfolio — Ariel Conde | Product Designer"
  description="Selected product design case studies by Ariel Conde. UX research, e-commerce, sustainable fashion and luxury retail."
>
  <div class="min-h-screen">
    <!-- Hero Section -->
    <section class="px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28">
      <div class="mx-auto max-w-2xl lg:max-w-7xl">
        <div class="flex flex-col gap-6 max-w-xl">
          <h1 class="text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl">
            Portfolio
          </h1>
          <p class="text-primary-950/70 dark:text-primary-200/70 text-lg sm:text-xl">
            Selected case studies in <strong class="font-medium text-primary-950 dark:text-primary-200">UX research</strong>, <strong class="font-medium text-primary-950 dark:text-primary-200">iterative design</strong> and <strong class="font-medium text-primary-950 dark:text-primary-200">product strategy</strong> — from luxury fashion e-commerce to sustainable retail.
          </p>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-12 mt-12 pt-12 border-t border-primary-950/10 dark:border-primary-200/10">
          <div class="flex flex-col gap-1">
            <span class="text-3xl font-medium tracking-tight">{sorted.length}</span>
            <span class="text-sm text-primary-950/50 dark:text-primary-200/50">Case studies</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-3xl font-medium tracking-tight">15+</span>
            <span class="text-sm text-primary-950/50 dark:text-primary-200/50">Years of experience</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-3xl font-medium tracking-tight">20+</span>
            <span class="text-sm text-primary-950/50 dark:text-primary-200/50">Projects delivered</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Cases Grid -->
    <section class="px-4 sm:px-6 lg:px-8 py-16">
      <div class="mx-auto max-w-2xl lg:max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sorted.map((caseItem) => (
            <a
              href={`/portfolio/${caseItem.slug}/`}
              class="group overflow-hidden rounded-3xl bg-primary-500/10 dark:bg-primary-400/10 flex flex-col transition-all duration-300 hover:-translate-y-1"
            >
              <!-- Cover image -->
              <div class="relative h-48 overflow-hidden">
                {caseItem.data.coverImage ? (
                  <Image
                    src={caseItem.data.coverImage}
                    alt={`${caseItem.data.client} — case study`}
                    width={800}
                    height={384}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full bg-primary-500/20 dark:bg-primary-400/20 flex items-center justify-center">
                    <span class="text-4xl opacity-30">✦</span>
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="flex flex-col gap-4 p-6 flex-1">
                <!-- Role label -->
                <p class="text-sm text-primary-950/50 dark:text-primary-200/50">
                  {caseItem.data.role}
                  {caseItem.data.duration && ` · ${caseItem.data.duration}`}
                </p>

                <!-- Client name -->
                <h2 class="text-xl font-medium tracking-tight group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-300">
                  {caseItem.data.client}
                </h2>

                <!-- Description -->
                <p class="text-primary-950/70 dark:text-primary-200/70 text-base line-clamp-2">
                  {caseItem.data.description}
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2">
                  {caseItem.data.tags.slice(0, 3).map((tag) => (
                    <span class="text-xs rounded-2xl border border-primary-950/20 dark:border-primary-200/20 px-3 py-1 text-primary-950/60 dark:text-primary-200/60">
                      {tag}
                    </span>
                  ))}
                  {caseItem.data.tags.length > 3 && (
                    <span class="text-xs rounded-2xl border border-primary-950/10 dark:border-primary-200/10 px-3 py-1 text-primary-950/40 dark:text-primary-200/40">
                      +{caseItem.data.tags.length - 3}
                    </span>
                  )}
                </div>

                <!-- CTA -->
                <div class="mt-auto pt-2">
                  <span class="text-primary-600 dark:text-primary-400 text-sm font-medium group-hover:underline">
                    View case study →
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="px-4 sm:px-6 lg:px-8 py-20">
      <div class="mx-auto max-w-2xl lg:max-w-7xl">
        <div class="bg-primary-500/10 dark:bg-primary-400/10 flex flex-col items-center gap-8 rounded-3xl px-5 py-16 text-center sm:gap-10">
          <div class="flex flex-col gap-4 sm:gap-6">
            <h2 class="mx-auto max-w-sm text-3xl font-medium tracking-tight sm:text-4xl">
              Interested in working together?
            </h2>
            <p class="text-primary-950/70 dark:text-primary-200/70 mx-auto max-w-2xl text-lg">
              I'm open to product designer roles at purpose-driven consumer companies across Europe.
            </p>
          </div>
          <a
            href="/contact"
            class="bg-primary-600 dark:bg-primary-400 hover:bg-primary-700 dark:hover:bg-primary-300 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-400 dark:text-primary-950 inline-flex items-center justify-center rounded-full border border-transparent px-5 py-3 text-base font-medium text-white transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Get in touch →
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
